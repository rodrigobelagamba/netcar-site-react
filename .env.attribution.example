# Pipeline offline de atribuicao. Copie para .env.attribution e use chmod 600.
# Nunca versione valores reais.

# Evolution: HTTPS direto (preferido).
EVO_BASE_URL=https://evolution.example.com
EVO_API_KEY=
EVO_INSTANCE=netcar-bot
EVO_ALLOW_INSECURE_HTTP=0
EVOLUTION_MESSAGE_LIMIT=1000
# A coleta sai com erro acima desta taxa, mas preserva os resultados validos.
# Falha de 100% sempre preserva o checkpoint anterior e sai com erro.
EVOLUTION_MAX_FAILURE_RATE_PERCENT=10

# Alternativa segura quando a Evolution so publica HTTP no VPS: tunel SSH.
# O runner substitui EVO_BASE_URL por http://127.0.0.1:EVO_SSH_LOCAL_PORT.
# EVO_SSH_TARGET=usuario@host.example.com
# EVO_SSH_IDENTITY_FILE=/Users/seu-usuario/.ssh/id_ed25519
EVO_SSH_PORT=22
EVO_SSH_LOCAL_PORT=18080
EVO_SSH_REMOTE_PORT=8080

# Log proprio do site. Authorization e usado por padrao; query token e legado.
WA_LOG_BASE_URL=https://wa.example.com
WA_LOG_TOKEN=
WA_LOG_ALLOW_INSECURE_HTTP=0
WA_LOG_ALLOW_QUERY_TOKEN=0

# Diretorios devem ser absolutos no runner. Vazios usam Library/Application Support
# e Library/Logs do usuario, fora do checkout.
# ATTRIBUTION_DATA_DIR=/Users/seu-usuario/Library/Application Support/Netcar/attribution
# ATTRIBUTION_LOG_DIR=/Users/seu-usuario/Library/Logs/NetcarAttribution
ATTRIBUTION_PYTHON=python3
ATTRIBUTION_SOURCE_TIMEZONE=America/Sao_Paulo
ATTRIBUTION_RETENTION_DAYS=365
ATTRIBUTION_LOG_RETENTION_DAYS=30
ATTRIBUTION_SESSION_GAP_HOURS=168
ATTRIBUTION_CLICK_WINDOW_HOURS=48
ATTRIBUTION_CLICK_FUTURE_SKEW_MINUTES=10
ATTRIBUTION_CRM_WINDOW_DAYS=30
ATTRIBUTION_SALE_WINDOW_DAYS=180
ATTRIBUTION_RETRY_ATTEMPTS=3
ATTRIBUTION_RETRY_DELAY_SECONDS=5
ATTRIBUTION_CONVERSION_CURRENCY=BRL

# Bancos. TLS e obrigatorio. Prefira verify-full com CA configurada.
ATTRIBUTION_SKIP_DATABASES=0
# Flags independentes para operacao parcial segura. SKIP_DATABASES=1 equivale a ambas.
ATTRIBUTION_SKIP_CRM=0
ATTRIBUTION_SKIP_SALES=0
CRM_DATABASE_URL=mysql+pymysql://usuario:senha@crm.example.com/netcar?sslmode=verify-full
CRM_SSLMODE=verify-full
# CRM_SSL_CA=/caminho/ca.pem
# CRM_SSL_CERT=/caminho/client-cert.pem
# CRM_SSL_KEY=/caminho/client-key.pem
PG_CONNECTION_STRING=postgresql://usuario:senha@erp.example.com/netcar?sslmode=verify-full
PGSSLMODE=verify-full
# PGSSLROOTCERT=/caminho/ca.pem
# PGSSLCERT=/caminho/client-cert.pem
# PGSSLKEY=/caminho/client-key.pem
CRM_TABLE=crm_negocio
ERP_SALES_TABLE=vendidos
ERP_CUSTOMERS_TABLE=cadclientes

# Para execucao/teste offline, snapshots substituem os bancos correspondentes.
# ATTRIBUTION_CRM_SNAPSHOT_CSV=/caminho/crm.csv
# ATTRIBUTION_SALES_SNAPSHOT_CSV=/caminho/vendas.csv
ATTRIBUTION_ALLOW_MISSING_CLICK_LOG=0

# Overrides opcionais de artefatos privados.
# EVOLUTION_OUTPUT_CSV=/caminho/atribuicao_whatsapp_leads.csv
# EVOLUTION_CHECKPOINT_PATH=/caminho/evolution_checkpoint.json
# EVOLUTION_AUDIT_JSON=/caminho/evolution_attribution_audit.json
# ATTRIBUTION_CLICK_LOG_PATH=/caminho/wa_clicks_log.jsonl
# WA_LOG_STATE_PATH=/caminho/wa_clicks_state.json
# ATTRIBUTION_OUTPUT_CSV=/caminho/atribuicao_whatsapp_leads_enriquecido.csv
# ATTRIBUTION_AUDIT_JSON=/caminho/atribuicao_whatsapp_audit.json
# ATTRIBUTION_CONFIRMED_CONVERSIONS_CSV=/caminho/conversoes_confirmadas.csv

# Snapshot de campanhas e opcional e nao faz upload de conversoes.
ATTRIBUTION_RUN_CAMPAIGN_SNAPSHOT=0
CAMPAIGN_SNAPSHOT_PLATFORMS=meta,google
CAMPAIGN_SNAPSHOT_RETENTION_DAYS=730
# CAMPAIGN_SNAPSHOT_OUTPUT_CSV=/caminho/campanhas_ativas_historico.csv
META_ACCESS_TOKEN=
META_AD_ACCOUNT=
META_GRAPH_VERSION=v22.0
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22
