# Home servida via index.php (injeta preload do banner para melhorar LCP).
# Se PHP não estiver disponível, cai no index.html normalmente.
<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

# Configuração de tipos MIME (deve vir primeiro)
<IfModule mod_mime.c>
  # JavaScript modules
  AddType application/javascript js mjs
  AddType text/javascript js mjs
  
  # JSON
  AddType application/json json webmanifest
  
  # CSS
  AddType text/css css
</IfModule>

# Configurações de cache para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Imagens
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS e JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
  
  # Fontes
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML (sem cache para permitir atualizações)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
  # Previne clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Previne MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # XSS Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Corrige tipo MIME para JavaScript modules
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript"
  </FilesMatch>

  # Banners e fotos do sistema legado (/imagens/) estavam saindo com
  # Cache-Control: max-age=1800 (30 min). Banner muda raramente: 7 dias.
  <If "%{REQUEST_URI} =~ m#^/imagens/#">
    Header set Cache-Control "public, max-age=604800"
  </If>

  # Assets do build (/assets/) têm hash no nome (ex.: index-Rjk3oydK.js):
  # o conteúdo nunca muda para um mesmo arquivo, então cache de 1 ano + immutable.
  # Em produção estavam saindo com max-age=1800 (30 min), forçando re-download
  # a cada visita e penalizando LCP de retorno. immutable evita revalidação.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Pastas internas: não indexar mesmo se crawler achar URL
  <If "%{REQUEST_URI} =~ m#^/(admin|sistema|api|backend)(/|$)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>

  # Legado / laudos: acessível pra humano, fora do índice
  <If "%{REQUEST_URI} =~ m#^/(Tour3D|Tour3DRC|arquivos/autocheck)(/|$)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# Rewrite Rules para SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # HTTPS canônico (http -> https://www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.netcarmultimarcas.com.br%{REQUEST_URI} [R=301,L]
  
  # Canônico da home: /index.html acessado direto -> / (301).
  # THE_REQUEST garante que só o request externo do browser/crawler é
  # redirecionado; o rewrite interno do SPA para index.html não casa aqui.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  
  # Redirects 301 — site legado PHP/HTML
  # QSD remove parâmetros obsoletos (id/código) do destino canônico.
  # URL enganosa: Netcar não oferece financiamento 100% / sem entrada.
  RewriteRule ^financiamento-sem-entrada/?$ /financiamento [R=301,L,QSD,NC]
  # Extensões legadas (.html/.php) caem no shell SPA e viram NotFound no React.
  # Sem QSD: preserva gclid/UTM da campanha.
  RewriteRule ^financiamento\.(php|html?)$ /financiamento [R=301,L,NC]
  RewriteRule ^sobre\.(php|html?)$ /sobre [R=301,L,NC]
  RewriteRule ^compra\.(php|html?)$ /compra [R=301,L,NC]
  RewriteRule ^atendimento-24h\.(php|html?)$ /atendimento-24h [R=301,L,NC]
  RewriteRule ^move-brasil\.(php|html?)$ /move-brasil [R=301,L,NC]
  RewriteRule ^blog\.(php|html?)$ /blog [R=301,L,NC]
  RewriteRule ^regioes-atendidas\.(php|html?)$ /regioes-atendidas [R=301,L,NC]
  RewriteRule ^comparar\.(php|html?)$ /comparar [R=301,L,NC]
  RewriteRule ^vender-meu-carro\.(php|html?)$ /compra [R=301,L,NC]
  RewriteRule ^seminovos\.(php|html?)$ /seminovos [R=301,L,QSD,NC]
  RewriteRule ^sobre-nos\.(php|html?)$ /sobre [R=301,L,QSD,NC]
  RewriteRule ^listagem-produtos\.(php|html?)$ /seminovos [R=301,L,QSD,NC]
  RewriteRule ^clientes?\.(php|html?)$ / [R=301,L,QSD,NC]
  RewriteRule ^contato\.(php|html?)$ /contato [R=301,L,QSD,NC]
  RewriteRule ^ficha-cadastral\.(php|html?)$ /seminovos [R=301,L,QSD,NC]
  RewriteRule ^compramos-seu-usado\.(php|html?)$ /compra [R=301,L,QSD,NC]
  # Canônico único da página de venda/compra de usado (mesmo componente React).
  # Sem QSD: preserva UTM e demais query params de campanha.
  RewriteRule ^compramos-seu-usado/?$ /compra [R=301,L,NC]
  RewriteRule ^vender-meu-carro/?$ /compra [R=301,L,NC]
  RewriteRule ^detalhe-produto-(.+)\.html?$ /seminovos [R=301,L,QSD,NC]
  RewriteRule ^detalhe-produto-(.+)$ /seminovos [R=301,L,QSD,NC]

  # Cidade no formato legado com barra (/seminovos/canoas) caía no shell do SPA
  # e virava soft 404. O canônico é /seminovos-{cidade}.
  RewriteRule ^seminovos/(alvorada|bento-goncalves|cachoeirinha|campo-bom|canoas|caxias-do-sul|estancia-velha|gramado|gravatai|guaiba|igrejinha|montenegro|novo-hamburgo|porto-alegre|sao-leopoldo|sapucaia-do-sul|taquara|viamao)/?$ /seminovos-$1 [R=301,L,QSD,NC]
  # Qualquer outro /seminovos/algo sem extensão volta para a listagem.
  # A checagem de ponto preserva arquivos reais da pasta legada seminovos/.
  RewriteCond %{REQUEST_URI} !\.
  RewriteRule ^seminovos/(.+)$ /seminovos [R=301,L,QSD,NC]

  # Consolidação editorial — posts que respondiam à MESMA intenção com o mesmo
  # template, trocando só a entidade (marca, categoria, modelo, faixa de preço).
  # Medição em 04/08/2026: 0,86 a 0,99 de similaridade textual entre irmãos.
  # O Google mantinha uma URL e tratava as demais como duplicadas, então o sinal
  # ficava diluído em vez de coberto. Cada intenção agora tem uma URL só.
  # Sem QSD: preserva gclid/UTM de quem chega por campanha ou link antigo.
  #
  # Marca e categoria vão para a landing transacional, que já é a página que
  # responde à busca e converte. Se a marca sair do estoque, a landing deixa de
  # ser gerada (mínimo de 3 veículos em generate-landings.js) — nesse caso o
  # destino aqui precisa passar a ser /seminovos.
  RewriteRule ^blog/(chery|chevrolet|fiat|honda|hyundai|jeep|nissan|volkswagen)-usado-em-esteio-vale-a-pena-2026/?$ /comprar-$1 [R=301,L,NC]
  RewriteRule ^blog/melhor-(hatch|sedan|suv)-seminovo-esteio-2026/?$ /comprar-$1 [R=301,L,NC]
  RewriteRule ^blog/(t-cross-highline-turbo|fox-comfortline|nivus-highline-turbo)-seminovo-esteio-2026/?$ /comprar-volkswagen [R=301,L,NC]
  RewriteRule ^blog/tracker-lt-turbo-seminovo-esteio-2026/?$ /comprar-chevrolet [R=301,L,NC]
  RewriteRule ^blog/compass-serie-s-t270-turbo-seminovo-esteio-2026/?$ /comprar-jeep [R=301,L,NC]
  RewriteRule ^blog/hrv-ex-seminovo-esteio-2026/?$ /comprar-honda [R=301,L,NC]
  # Faixa de preço: quatro recortes do mesmo texto viram o guarda-chuva.
  RewriteRule ^blog/seminovo-ate-(60|80|120|150)-mil-esteio-2026/?$ /blog/quanto-custa-seminovo-esteio-2026 [R=301,L,NC]
  # Intenção idêntica à do artigo manual, publicada com slug diferente.
  RewriteRule ^blog/checklist-comprar-seminovo-o-que-verificar/?$ /blog/o-que-verificar-antes-de-comprar-seminovo [R=301,L,NC]
  # Regionais que só trocavam topônimo sobre o mesmo corpo de texto.
  RewriteRule ^blog/seminovos-(vale-do-cai-procedencia|paranhana-igrejinha-taquara)-2026/?$ /blog/seminovos-grande-porto-alegre-estoque-e-procedencia-2026 [R=301,L,NC]

  # Tours 3D antigos (2016) — Tour3D e Tour3DRC
  RewriteRule ^Tour3DR?C?(/.*)?$ / [R=301,L,NC]
  
  # Home para bots: precisa vir ANTES do short-circuit de arquivo/diretório,
  # senão a raiz "/" casa com o diretório docroot (-d) e o crawler recebe o
  # index.html (shell vazio do React) em vez do conteúdo real do seo-pagina.php.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|Slackbot-LinkExpanding|Slack-ImgProxy|Google-Structured-Data-Testing-Tool|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteCond %{REQUEST_URI} ^/?$ [NC]
  RewriteRule ^$ seo-pagina.php [L,QSA]
  
  # PHP social — antes do fallback SPA (reviews, stories, oauth, sync)
  RewriteRule ^social/v1/.+\.php$ - [L]

  # Bridge social — PHP antes do React (paginação reviews/stories legado)
  RewriteRule ^embedsocial-bridge\.php$ - [L]

  # Feed WhatsApp Catalog — sempre ao vivo via API (antes do -f estático)
  RewriteRule ^feeds/whatsapp-catalog\.csv$ feeds/whatsapp-catalog.php?format=csv [L,QSA]
  RewriteRule ^feeds/whatsapp-catalog\.xml$ feeds/whatsapp-catalog.php?format=xml [L,QSA]
  RewriteRule ^feeds/whatsapp-catalog\.php$ - [L]

  # Pastas do servidor que NÃO são SPA (gerenciador PHP + API + backend legado).
  # Sem isso, /admin/ e /sistema/ caem no index.php React (bug após remoção do -d abaixo).
  RewriteRule ^(admin|sistema|api|backend)(/|$) - [L]

  # Primeiro: servir só arquivos reais (-f).
  # NÃO usar -d genérico: o docroot de produção ainda tem pastas legadas
  # (seminovos/, veiculo/, etc.) que interceptavam a URL e mandavam para not-found.html.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # Segundo: não reescrever arquivos estáticos por extensão
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|webmanifest|xml|txt|map)$ [NC]
  RewriteRule ^ - [L]
  
  # Terceiro: não reescrever pasta assets
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteRule ^ - [L]
  
  # /not-found.html é resquício do site legado e estava em 302 para si mesmo —
  # o Googlebot registrava isso como erro de redirecionamento. Agora responde 410.
  RewriteRule ^not-found\.html$ - [G,L]

  # Quarto: não reescrever index.html (evita loop no fallback do SPA)
  RewriteCond %{REQUEST_URI} ^/index\.html$ [NC]
  RewriteRule ^ - [L]
  
  # Sexto: interceptar rotas principais para bots (HTML com conteúdo real)
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|Slackbot-LinkExpanding|Slack-ImgProxy|Google-Structured-Data-Testing-Tool|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteCond %{REQUEST_URI} ^/(seminovos|sobre|contato|compra|blog)/?$ [NC]
  RewriteRule ^ seo-pagina.php [L,QSA]

  # SEO estático para crawlers (blog + páginas locais)
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteRule ^blog/([^/]+)/?$ seo-static/blog-$1.html [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteRule ^regioes-atendidas/?$ seo-static/regions-hub.html [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  # Sem o -f, /seminovos-automaticos casava aqui e apontava para um city-*.html
  # inexistente: o bot recebia o shell do SPA com o title da home.
  RewriteCond %{DOCUMENT_ROOT}/seo-static/city-$1.html -f
  RewriteRule ^seminovos-([a-z0-9-]+)/?$ seo-static/city-$1.html [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteCond %{DOCUMENT_ROOT}/seo-static/sell-city-$1.html -f
  RewriteRule ^vender-carro-([a-z0-9-]+)/?$ seo-static/sell-city-$1.html [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteCond %{DOCUMENT_ROOT}/seo-static/landing-$1.html -f
  RewriteRule ^comprar-([a-z0-9-]+)/?$ seo-static/landing-$1.html [L]

  # Páginas de conteúdo SEO (financiamento, atendimento-24h, automáticos) para crawlers
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteCond %{DOCUMENT_ROOT}/seo-static/page-$1.html -f
  RewriteRule ^(financiamento|atendimento-24h|move-brasil|seminovos-automaticos)/?$ seo-static/page-$1.html [L]

  # Sétimo: interceptar /veiculo/{slug} APENAS quando for bot/crawler (meta tags para WhatsApp)
  # Usuários normais acessam diretamente o React app
  RewriteCond %{REQUEST_URI} ^/veiculo/ [NC]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|WhatsAppBot|Twitterbot|LinkedInBot|Slackbot|SkypeUriPreview|Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|curl|wget|facebook|Facebot|Slurp|ia_archiver|Mediapartners|Applebot|BingPreview|Slackbot-LinkExpanding|Slack-ImgProxy|Slackbot|SkypeUriPreview|LinkedInBot|Twitterbot|WhatsApp|facebookexternalhit|Facebot|Google-Structured-Data-Testing-Tool|bot|crawler|spider|scraper) [NC,OR]
  RewriteCond %{QUERY_STRING} _escaped_fragment_= [NC]
  RewriteRule ^veiculo/(.+)$ detalhe-veiculo.php?slug=$1 [L,QSA]
  
  # SPA React — index.php serve o shell (home ganha preload LCP via PHP)
  RewriteRule ^ index.php [L]
</IfModule>
