# This directory also contains API files, but its page URL has no trailing slash.
Options -Indexes
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions AllowNoSlash

  # Local rewrite rules replace parent rules: preserve the canonical origin.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.netcarmultimarcas\.com\.br$ [NC]
  RewriteRule ^ https://www.netcarmultimarcas.com.br%{REQUEST_URI} [R=301,L]

  # Match the request URI: a directory without its slash has a different
  # per-directory rule subject. Serve both spellings to avoid cached 301 loops.
  RewriteCond %{REQUEST_URI} ^/entregas/?$
  RewriteRule ^ /index.php [END,QSA]
</IfModule>
