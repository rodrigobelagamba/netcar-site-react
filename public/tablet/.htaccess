# This legacy directory has local rules, so Apache does not use root rewrites.
# Route only its catalog entry to React; preserve legacy assets and car links.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.netcarmultimarcas\.com\.br$ [NC]
  RewriteRule ^ https://www.netcarmultimarcas.com.br%{REQUEST_URI} [R=301,L]

  RewriteRule ^(index\.php|seminovos\.html)$ /tablet/ [R=302,L]
  RewriteRule ^$ /index.php [END,QSA]

  RewriteRule ^carrotb-(.*)\.html$ tablet_carro.php?id=$1

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html
</IfModule>
