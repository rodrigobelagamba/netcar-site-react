# Token de acesso ao painel (obrigatório em produção)
DEVOPS_TOKEN=change-me-to-a-long-random-string

# Porta HTTP do painel
PORT=3090
# Opcional para QA local: HOST=127.0.0.1 (produção mantém 0.0.0.0).

# Raiz do site-react (em Docker: /workspace; em dev local: ..)
WORKSPACE_ROOT=..

# Timeout de jobs em ms (default 45 min)
JOB_TIMEOUT_MS=2700000

# Auditoria de equipamentos: diariamente às 07:00, America/Sao_Paulo.
# O padrão é true em produção e false em desenvolvimento. A escolha salva no
# painel prevalece sobre este padrão. Não pesquisa a web nem publica o site.
# EQUIPMENT_CRON_ENABLED=false
