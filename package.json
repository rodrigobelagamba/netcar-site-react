{
  "name": "netcar-catalog-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-landings.js && node scripts/validate-regional-seo.js && node scripts/validate-blog-intent.js && node scripts/generate-sitemap.js && node scripts/generate-seo-assets.js && tsx scripts/validate-demand-runtime.ts && tsx scripts/validate-showroom-runtime.ts && node scripts/validate-generated-seo.js && node scripts/validate-server-routing.js && node scripts/validate-tracking-runtime.js && node scripts/generate-whatsapp-catalog-feed.js && tsc && vite build && node scripts/defer-built-css.js && node scripts/copy-social-php.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-landings": "node scripts/generate-landings.js",
    "generate-blog": "node scripts/generate-blog.js",
    "blog:rotate": "node scripts/generate-blog.js",
    "weekly": "node scripts/generate-blog.js && node scripts/validate-blog-intent.js && npm run deploy:local",
    "seo:generate": "node scripts/generate-seo-assets.js",
    "seo:validate-regional": "node scripts/validate-regional-seo.js",
    "seo:validate-generated": "node scripts/validate-generated-seo.js",
    "seo:validate-demand-runtime": "tsx scripts/validate-demand-runtime.ts",
    "stock:validate-showroom": "tsx scripts/validate-showroom-runtime.ts",
    "seo:validate-server": "node scripts/validate-server-routing.js",
    "tracking:validate": "node scripts/validate-tracking-runtime.js",
    "seo:validate-blog": "node scripts/validate-blog-intent.js",
    "catalog:whatsapp": "node scripts/generate-whatsapp-catalog-feed.js",
    "report:icheck": "tsx scripts/generate-icheck-report.mjs",
    "local-seo:status": "node scripts/local-seo-status.mjs",
    "local-seo:validate": "node scripts/local-seo-status.mjs --validate",
    "preview": "vite preview",
    "deploy:local": "node scripts/deploy-local.js",
    "deploy:dist": "node scripts/deploy-dist.js",
    "deploy:ssh-setup": "node scripts/ssh-setup.js",
    "deploy:local:win": "scripts\\deploy-local.bat",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
